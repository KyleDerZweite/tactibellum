{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tactibellum patch catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sources",
    "notes",
    "units",
    "spells",
    "specialists",
    "items",
    "devices",
    "towers",
    "blueprints"
  ],
  "properties": {
    "version": { "$ref": "#/$defs/nonemptyString" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" },
      "uniqueItems": true
    },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/nonemptyString" } },
    "units": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/unit" }
    },
    "spells": { "$ref": "#/$defs/namedEntryMap" },
    "specialists": { "$ref": "#/$defs/namedEntryMap" },
    "items": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/item" }
    },
    "devices": { "$ref": "#/$defs/namedEntryMap" },
    "towers": { "$ref": "#/$defs/namedEntryMap" },
    "blueprints": { "$ref": "#/$defs/namedEntryMap" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "nonemptyString": { "type": "string", "minLength": 1 },
    "nonnegativeNumber": { "type": "number", "minimum": 0 },
    "nullableNonnegativeNumber": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonemptyString" },
      "uniqueItems": true
    },
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hp": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "levelRule": {
          "const": "linear-1-to-9"
        },
        "attack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "damage": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "intervalSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["damage", "intervalSeconds"]
        }
      },
      "required": ["hp", "source", "levelRule"]
    },
    "combatModifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hpRate": {
          "type": "number",
          "minimum": 0
        },
        "damageRate": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": []
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cost"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "cost": {
          "$ref": "#/$defs/nullableNonnegativeNumber"
        },
        "combatModifier": {
          "$ref": "#/$defs/combatModifier"
        }
      }
    },
    "tech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cost", "statModifiers", "addedRoles"],
      "properties": {
        "name": { "$ref": "#/$defs/nonemptyString" },
        "cost": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "combatModifier": { "$ref": "#/$defs/combatModifier" },
        "statModifiers": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "addedRoles": { "$ref": "#/$defs/roles" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "cost",
        "unlockCost",
        "tier",
        "footprint",
        "range",
        "speed",
        "isAir",
        "canTargetAir",
        "canTargetGround",
        "roles",
        "techs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/nonemptyString" },
        "cost": { "$ref": "#/$defs/nonnegativeNumber" },
        "unlockCost": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "tier": { "enum": [100, 200, 300, 400, 800] },
        "combat": { "$ref": "#/$defs/combat" },
        "footprint": { "$ref": "#/$defs/footprint" },
        "range": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "speed": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "isAir": { "type": "boolean" },
        "canTargetAir": { "type": "boolean" },
        "canTargetGround": { "type": "boolean" },
        "roles": { "$ref": "#/$defs/roles" },
        "techs": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/tech" }
        }
      }
    },
    "namedEntryMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/namedEntry" }
    },
    "namedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cost"],
      "properties": {
        "name": { "$ref": "#/$defs/nonemptyString" },
        "cost": { "$ref": "#/$defs/nullableNonnegativeNumber" }
      }
    }
  }
}
